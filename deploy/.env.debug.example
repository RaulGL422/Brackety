# Debug environment (docs/modulos/entornos.md): copy to .env.debug. Nothing here is shared with production:
# its own database, secrets, superadmin, Cloudflare tunnel and Access application. Never real personal data.
DB_USER=
DB_PASSWORD=
# Its own, never production's (openssl rand -base64 48).
JWT_SECRET=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD_HASH=
# The Access application that covers the three debug hostnames.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
LEGAL_OWNER_NAME=
PRIVACY_CONTACT_EMAIL=
PUBLIC_BASE_URL=https://brackety-debug.rgal.dev
CORS_ALLOWED_ORIGINS=https://brackety-debug.rgal.dev
# A second tunnel (Zero Trust → Tunnels): web → http://web:80, api → http://api:8080, admin → http://admin:80.
CLOUDFLARE_TUNNEL_TOKEN=
# Empty on purpose: emails only go to the API log, Google sign-in answers 503, the import is hidden.
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
ANTHROPIC_API_KEY=
# Images built from development with the scenarios and the Scenarios tab.
IMAGE_TAG=dev
# On the SSD, next to production's but never the same folder.
DB_DATA=/mnt/ssd/brackety-debug/pgdata
API_PORT=8090
WEB_PORT=8091
ADMIN_PORT=8092
# Generic accounts (club1, arbitro1…) only exist in debug.
DEMO_ACCOUNTS_ENABLED=true
