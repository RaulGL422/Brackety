DB_URL=jdbc:postgresql://db:5432/brackety
DB_USER=
DB_PASSWORD=
# Required, at least 32 bytes: openssl rand -base64 48. Without it the API does not start.
JWT_SECRET=
# Google OAuth client IDs (web and Android), comma separated. Empty: Google sign-in answers 503.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
# Empty: emails are only written to the API log. Set: EMAIL_FROM and PUBLIC_BASE_URL are required too.
RESEND_API_KEY=
EMAIL_FROM=Brackety <no-reply@rgal.dev>
FCM_CREDENTIALS=
# Superadmin. Empty: the superadmin login answers 503. The hash comes from the run config
# "server · superadmin password hash"; keep it in single quotes (it has $ signs).
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD_HASH=
# Cloudflare Access of the admin host: team domain (myteam.cloudflareaccess.com) and the application AUD tag.
# Either empty: every /api/v1/admin/** request answers 503.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
PRIVACY_CONTACT_EMAIL=
# Public web URL, used for the links in emails (e.g. https://brackety.rgal.dev).
PUBLIC_BASE_URL=
CLOUDFLARE_TUNNEL_TOKEN=
CORS_ALLOWED_ORIGINS=
# Optional: requests per IP and minute (defaults 3000 / 20 sign-in / 600 refresh).
# RATE_LIMIT_PER_MINUTE=3000
# RATE_LIMIT_AUTH_PER_MINUTE=20
# RATE_LIMIT_REFRESH_PER_MINUTE=600

# Public URL of the API, baked into web and admin when they are built locally (CI uses the repo variable).
API_BASE_URL=
# Admin host URL (https://admin.<domain>), baked into admin: it calls the API through its own proxy.
# Empty: API_BASE_URL (then the superadmin API gets no Access header and answers 403).
ADMIN_API_BASE_URL=
# Image tag to run: latest (main) or a release such as 1.2.0.
IMAGE_TAG=latest
# Postgres data: the named volume by default; on the Pi, a path on the SSD (e.g. /mnt/ssd/brackety/pgdata).
DB_DATA=pgdata
# Backups: folder on a disk other than the database one, and the age public key (age1...).
BACKUP_DIR=
BACKUP_AGE_RECIPIENT=
API_PORT=8080
WEB_PORT=8081
ADMIN_PORT=8082
# Liga Yoseikan phase 1 prototype only: true creates club1, ayudante1-2 and arbitro1-5 with
# password = username. Weak on purpose (accepted risk); set back to false after the phase.
DEMO_ACCOUNTS_ENABLED=false
# Event date (YYYY-MM-DD) used for the age categories; empty = the day of the first start.
DEMO_EVENT_DATE=
